# Copiar para .env (local) ou definir no Coolify (produção). Nunca fazer commit do .env.

# Local: Postgres embutido arrancado pelo `npm run dev`. Em produção: o URL do Postgres do Coolify.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/treinos

# Password de entrada na app (mínimo 8 caracteres).
APP_PASSWORD=

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres aleatórios).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# URL público da app (callbacks OAuth e webhook do Strava).
APP_URL=http://localhost:3000

# Fase 1 — app da API do Strava (strava.com/settings/api).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
